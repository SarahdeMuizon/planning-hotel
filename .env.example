# Mot de passe de la gérante
MANAGER_PASSWORD=changez-moi

# Clé secrète pour les JWT (générez une clé longue et aléatoire)
JWT_SECRET=votre-cle-secrete-longue-et-aleatoire

# Base de données SQLite locale (dev)
LIBSQL_URL=file:local.db

# Pour Vercel/Turso (production) :
# LIBSQL_URL=libsql://votre-db.turso.io
# LIBSQL_AUTH_TOKEN=votre-token-turso
